{% layout none %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Order {{ order.name }} confirmed — {{ shop.name }}</title>
</head>
<body style="margin:0;padding:0;background-color:#FBFAF8;-webkit-text-size-adjust:100%;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#FBFAF8;padding:32px 16px;">
    <tr>
      <td align="center">
        <!-- Email width: 600 -->
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:100%;background-color:#FFFFFF;border:1px solid #E6E2DB;border-radius:12px;overflow:hidden;">

          <!-- HEADER -->
          <tr>
            <td align="center" style="background-color:#FBFAF8;padding:36px 24px 28px;">
              <img src="https://gecomo-assets.pages.dev/logo-icon.png" width="72" height="72" alt="{{ shop.name }}" style="display:block;width:72px;height:72px;margin:0 auto;">
              <p style="margin:14px 0 0;font-family:Georgia,'Times New Roman',serif;font-size:22px;letter-spacing:6px;color:#121212;font-weight:normal;">GECOMO</p>
              <p style="margin:4px 0 0;font-family:Helvetica,Arial,sans-serif;font-size:11px;letter-spacing:3px;color:#6F6B65;text-transform:uppercase;">Effortless, natural brows</p>
            </td>
          </tr>

          <!-- HERO -->
          <tr>
            <td align="center" style="padding:36px 40px 8px;">
              <h1 style="margin:0;font-family:Georgia,'Times New Roman',serif;font-size:26px;color:#121212;font-weight:normal;">Thank you for your order</h1>
              <p style="margin:10px 0 0;font-family:Helvetica,Arial,sans-serif;font-size:15px;color:#3F3D3A;line-height:1.6;">Hi {{ customer.first_name | default: 'there' }}, we're getting your order ready to be shipped.<br>You'll receive a tracking number the moment it's on its way.</p>
            </td>
          </tr>

          <!-- ORDER META -->
          <tr>
            <td style="padding:24px 40px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#FBFAF8;border:1px solid #E6E2DB;border-radius:8px;">
                <tr>
                  <td style="padding:14px 20px;font-family:Helvetica,Arial,sans-serif;font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:#6F6B65;">Order</td>
                  <td style="padding:14px 20px;font-family:Helvetica,Arial,sans-serif;font-size:13px;color:#121212;text-align:right;font-weight:bold;">{{ order.name }}</td>
                </tr>
                <tr>
                  <td style="padding:0 20px 14px;font-family:Helvetica,Arial,sans-serif;font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:#6F6B65;">Date</td>
                  <td style="padding:0 20px 14px;font-family:Helvetica,Arial,sans-serif;font-size:13px;color:#121212;text-align:right;">{{ order.created_at | date: "%B %d, %Y" }}</td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- ITEMS -->
          <tr>
            <td style="padding:24px 40px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                {% for line_item in order.line_items %}
                <tr>
                  <td style="padding:10px 0;border-bottom:1px solid #F0EDE6;vertical-align:middle;">
                    <table role="presentation" cellpadding="0" cellspacing="0" width="100%">
                      <tr>
                        <td width="64" style="vertical-align:middle;">
                          {% if line_item.image %}
                            <img src="{{ line_item.image | image_url: width: 128 }}" width="56" height="56" alt="{{ line_item.title }}" style="display:block;width:56px;height:56px;object-fit:cover;border-radius:8px;border:1px solid #F0EDE6;">
                          {% endif %}
                        </td>
                        <td style="vertical-align:middle;padding-left:14px;">
                          <p style="margin:0;font-family:Helvetica,Arial,sans-serif;font-size:14px;color:#121212;">{{ line_item.title }}</p>
                          {% if line_item.variant_title %}<p style="margin:3px 0 0;font-family:Helvetica,Arial,sans-serif;font-size:12px;color:#6F6B65;">{{ line_item.variant_title }}</p>{% endif %}
                          <p style="margin:3px 0 0;font-family:Helvetica,Arial,sans-serif;font-size:12px;color:#6F6B65;">Qty {{ line_item.quantity }}</p>
                        </td>
                        <td align="right" style="vertical-align:middle;font-family:Helvetica,Arial,sans-serif;font-size:14px;color:#121212;white-space:nowrap;">{{ line_item.line_price | money }}</td>
                      </tr>
                    </table>
                  </td>
                </tr>
                {% endfor %}
              </table>
            </td>
          </tr>

          <!-- TOTALS -->
          <tr>
            <td style="padding:16px 40px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="padding:4px 0;font-family:Helvetica,Arial,sans-serif;font-size:13px;color:#6F6B65;">Subtotal</td>
                  <td align="right" style="padding:4px 0;font-family:Helvetica,Arial,sans-serif;font-size:13px;color:#3F3D3A;">{{ order.subtotal_price | money }}</td>
                </tr>
                {% for shipping_method in order.shipping_methods %}
                <tr>
                  <td style="padding:4px 0;font-family:Helvetica,Arial,sans-serif;font-size:13px;color:#6F6B65;">Shipping — {{ shipping_method.title }}</td>
                  <td align="right" style="padding:4px 0;font-family:Helvetica,Arial,sans-serif;font-size:13px;color:#3F3D3A;">{{ shipping_method.price | money }}</td>
                </tr>
                {% endfor %}
                {% if order.tax_price > 0 %}
                <tr>
                  <td style="padding:4px 0;font-family:Helvetica,Arial,sans-serif;font-size:13px;color:#6F6B65;">Tax</td>
                  <td align="right" style="padding:4px 0;font-family:Helvetica,Arial,sans-serif;font-size:13px;color:#3F3D3A;">{{ order.tax_price | money }}</td>
                </tr>
                {% endif %}
                <tr>
                  <td style="padding:12px 0 4px;border-top:1px solid #E6E2DB;font-family:Georgia,'Times New Roman',serif;font-size:18px;color:#121212;">Total</td>
                  <td align="right" style="padding:12px 0 4px;border-top:1px solid #E6E2DB;font-family:Georgia,'Times New Roman',serif;font-size:18px;color:#121212;">{{ order.total_price | money }}</td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- SHIP TO -->
          <tr>
            <td style="padding:24px 40px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#FBFAF8;border:1px solid #E6E2DB;border-radius:8px;">
                <tr>
                  <td style="padding:16px 20px;">
                    <p style="margin:0 0 6px;font-family:Helvetica,Arial,sans-serif;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:#6F6B65;">Shipping to</p>
                    {% if order.shipping_address %}
                    <p style="margin:0;font-family:Helvetica,Arial,sans-serif;font-size:14px;color:#121212;line-height:1.6;">
                      {{ order.shipping_address.name }}<br>
                      {% if order.shipping_address.company %}{{ order.shipping_address.company }}<br>{% endif %}
                      {{ order.shipping_address.address1 }}<br>
                      {% if order.shipping_address.address2 %}{{ order.shipping_address.address2 }}<br>{% endif %}
                      {{ order.shipping_address.city }}{% if order.shipping_address.province %}, {{ order.shipping_address.province }}{% endif %} {{ order.shipping_address.zip }}<br>
                      {{ order.shipping_address.country }}
                    </p>
                    {% endif %}
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- CTA -->
          <tr>
            <td align="center" style="padding:32px 40px 8px;">
              <a href="{{ order.order_status_url }}" target="_blank" style="display:inline-block;background-color:#121212;color:#FBFAF8;text-decoration:none;font-family:Helvetica,Arial,sans-serif;font-size:13px;letter-spacing:2px;text-transform:uppercase;padding:16px 44px;border-radius:999px;">View your order</a>
            </td>
          </tr>

          <!-- FREE BROW PLAYBOOK -->
          <tr>
            <td style="padding:28px 40px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#FBFAF8;border:1px solid #E6E2DB;border-radius:12px;">
                <tr>
                  <td align="center" style="padding:28px 24px;">
                    <p style="margin:0;font-family:Helvetica,Arial,sans-serif;font-size:11px;letter-spacing:2px;color:#8A6A4F;text-transform:uppercase;font-weight:bold;">Your free gift</p>
                    <p style="margin:10px 0 0;font-family:Georgia,'Times New Roman',serif;font-size:22px;color:#121212;font-weight:normal;">The Brow Playbook</p>
                    <p style="margin:8px 0 0;font-family:Helvetica,Arial,sans-serif;font-size:13px;color:#6F6B65;line-height:1.6;">Every order includes our step-by-step guide to your best natural brows — shade matching, brow mapping, and daily routine. Yours free ($19 value).</p>
                    <a href="https://shopgecomo.com/gecomo-brow-playbook.pdf" target="_blank" style="display:inline-block;margin-top:18px;border:1px solid #121212;color:#121212;text-decoration:none;font-family:Helvetica,Arial,sans-serif;font-size:12px;letter-spacing:2px;text-transform:uppercase;padding:13px 36px;border-radius:999px;">Download your playbook</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- FOOTER -->
          <tr>
            <td align="center" style="background-color:#FBFAF8;padding:32px 24px 28px;border-top:1px solid #E6E2DB;">
              <img src="https://gecomo-assets.pages.dev/logo-icon.png" width="36" height="36" alt="{{ shop.name }}" style="display:block;width:36px;height:36px;margin:0 auto;">
              <p style="margin:12px 0 0;font-family:Helvetica,Arial,sans-serif;font-size:12px;color:#6F6B65;line-height:1.7;">
                Questions about your order?<br>
                <a href="mailto:hello@shopgecomo.com" style="color:#121212;text-decoration:underline;">hello@shopgecomo.com</a>
              </p>
              <p style="margin:16px 0 0;font-family:Helvetica,Arial,sans-serif;font-size:11px;color:#9C978F;">&copy; {{ "now" | date: "%Y" }} {{ shop.name }} &middot; {{ shop.address.street }}</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
